# Modo de Ejecución: 'PAPER' (Simulación en tiempo real) o 'LIVE' (Binance Real)
EXECUTION_MODE=PAPER

# Puerto para el servidor web de salud (Render / Railway asignan esto automáticamente)
PORT=8080

# Notificaciones Push a Telegram en tu teléfono (Opcional pero recomendado)
# Obtén tu token gratis hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# Obtén tu chat ID hablando con @userinfobot en Telegram
TELEGRAM_CHAT_ID=

# Claves de Binance API (Solo requeridas si cambias a EXECUTION_MODE=LIVE)
# IMPORTANTE: En Binance, activa solo "Lectura" y "Habilitar Futuros". NUNCA actives retiros.
BINANCE_API_KEY=
BINANCE_API_SECRET=
USE_TESTNET=False
